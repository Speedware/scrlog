<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>scrlog</RootNamespace>
    <AssemblyName>scrlog</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\scrlog.ico</ApplicationIcon>

    <Version>2.0.2</Version>
    <Product>Scrlog</Product>
    <AssemblyTitle>Scrlog</AssemblyTitle>
    <Description>Запись экрана по расписанию</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Позволяет собирать net472 без установленного Targeting Pack (в т.ч. на CI) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
